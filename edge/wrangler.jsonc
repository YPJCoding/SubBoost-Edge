{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "edgesub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-02-07",
  "vars": {
    "SUBCONVERTER_BACKEND": "https://api.dler.io/sub",
    "SUBCONVERTER_FALLBACK_BACKENDS": "https://pub-api-1.bianyuan.xyz/sub,https://api.wcc.best/sub"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SUB_KV",
      "id": "7ce17a19f91549cc865dd6a914c68c63"
    }
  ],
  // Must name this Worker itself: each scheduled refresh then runs in its
  // own invocation with its own CPU budget instead of sharing the cron's.
  "services": [{ "binding": "SELF", "service": "edgesub" }],
  "durable_objects": {
    "bindings": [{ "name": "SUB_STORE", "class_name": "SubscriptionStore" }]
  },
  "migrations": [{ "tag": "v1-subscription-store", "new_sqlite_classes": ["SubscriptionStore"] }],
  "triggers": {
    "crons": ["0 */6 * * *", "17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
